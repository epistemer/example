package admin

import (
	"github.com/epistemer/i18n"
	"github.com/epistemer/ui/elements"
	"github.com/epistemer/ui/layout"

	"github.com/epistemer/example/internal/admin/adminroutes"
	"github.com/epistemer/example/internal/ids"
)

templ speakersPage(table templ.Component) {
	@layout.PageHeader(adminroutes.L10nSpeakers) {
		@elements.Button().Variant(elements.Outline).Href(adminroutes.SpeakersImport()) {
			{ L10nImport.T(ctx) }
		}
		@elements.Button().Href(adminroutes.SpeakersNew()) {
			{ L10nNewSpeaker.T(ctx) }
		}
	}
	@table
}

templ speakerFormPage(f *SpeakerForm, id ids.SpeakerID) {
	{{ title := L10nNewSpeaker }}
	{{ action := adminroutes.SpeakersCreate().URL() }}
	if id != 0 {
		{{ title = i18n.Static(f.Name.Value()) }}
		{{ action = adminroutes.SpeakersUpdate(id).URL() }}
	}
	@layout.PageHeader(title).Breadcrumbs(layout.Crumb{Href: adminroutes.Speakers(), Text: adminroutes.L10nSpeakers}, layout.Crumb{Text: title})
	<form method="post" action={ templ.SafeURL(action) } enctype="multipart/form-data" novalidate>
		@formErrors(f.Form)
		@fields(f.Form)
		@elements.Button().Submit() {
			{ L10nSave.T(ctx) }
		}
	</form>
}

templ importPage(f *ImportForm, people, photos int) {
	@layout.PageHeader(L10nImport).Breadcrumbs(layout.Crumb{Href: adminroutes.Speakers(), Text: adminroutes.L10nSpeakers}, layout.Crumb{Text: L10nImport})
	if people > 0 {
		@elements.Alert().Tone(elements.Success) {
			{ L10nImported.T(ctx, people, photos) }
		}
	}
	<form method="post" action={ templ.SafeURL(adminroutes.SpeakersImportPost().URL()) } enctype="multipart/form-data" novalidate>
		@formErrors(f.Form)
		@fields(f.Form)
		@elements.Button().Submit() {
			{ L10nImport.T(ctx) }
		}
	</form>
}
