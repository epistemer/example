# Development settings for a local run, read by `make` targets:
#   set -a; . ./dev.env; set +a
# Only for the local database of compose.yaml; never for a deployment.
CONFAB_DB_URL=postgres://confab:confab@127.0.0.1:5434/confab
CONFAB_AUTH_ISSUER=Confab
CONFAB_AUTH_SECRET=dev-only-secret-dev-only-secret-0123456789
CONFAB_AUTH_COOKIE_INSECURE=true
CONFAB_AUTH_PASSWORD_MEMORY=19
CONFAB_AUTH_PASSWORD_TIME=1
CONFAB_DEMO_PASSWORD=ada-lovelace-writes-the-first-program
