# confab: environment variables.
# Generated by cfgx from the schema; don't edit. Each is commented out at
# its default.

# The config file to read, instead of searching for confab.yaml.
# CONFAB_CONFIG=

# Minimum log level; one of debug, info, warn, error.
# Key log.level, flag --log-level. Used by every command.
# CONFAB_LOG_LEVEL=info

# Output format; one of text, json.
# Key log.format, flag --log-format. Used by every command.
# CONFAB_LOG_FORMAT=text

# Address to listen on.
# Key server.addr, flag --server-addr. Used by Serve.
# CONFAB_SERVER_ADDR=localhost:8080

# Address people reach the app at.
# Key server.public_url, flag --server-public-url. Used by Serve.
# CONFAB_SERVER_PUBLIC_URL=http://localhost:8080

# How long to wait for requests to finish when stopping.
# Key server.shutdown_timeout, flag --server-shutdown-timeout. Used by Serve.
# CONFAB_SERVER_SHUTDOWN_TIMEOUT=10s

# Store file: settings, translations and sign-ins.
# Key storage.bolt, flag --storage-bolt. Used by Serve, Seed.
# CONFAB_STORAGE_BOLT=confab.db

# Directory of uploaded files.
# Key storage.files, flag --storage-files. Used by Serve, Seed.
# CONFAB_STORAGE_FILES=files

# PostgreSQL connection URL.
# Required. Secret: set it in the environment, not here.
# Key db.url. Used by Serve, Migrate, Seed.
# CONFAB_DB_URL=

# Directory each message is written to, one file per message.
# Key mail.outbox, flag --mail-outbox. Used by Serve, Seed.
# CONFAB_MAIL_OUTBOX=outbox

# Issuer: the name in tokens and authenticator apps.
# Required.
# Key auth.issuer, flag --auth-issuer. Used by Serve, Seed.
# CONFAB_AUTH_ISSUER=

# Master secret, at least 32 bytes; every key is derived from it.
# Required. Secret: set it in the environment, not here.
# Key auth.secret. Used by Serve, Seed.
# CONFAB_AUTH_SECRET=

# Previous master secret, while rotating.
# Secret: set it in the environment, not here.
# Key auth.secret_previous. Used by Serve, Seed.
# CONFAB_AUTH_SECRET_PREVIOUS=

# Origins whose cross-origin requests are trusted.
# Key auth.trusted_origins, flag --auth-trusted-origins. Used by Serve, Seed.
# CONFAB_AUTH_TRUSTED_ORIGINS=

# Idle lifetime of a session.
# Key auth.session.idle, flag --auth-session-idle. Used by Serve, Seed.
# CONFAB_AUTH_SESSION_IDLE=24h0m0s

# Idle lifetime of a remembered session.
# Key auth.session.remembered_idle, flag --auth-session-remembered-idle. Used by Serve, Seed.
# CONFAB_AUTH_SESSION_REMEMBERED_IDLE=720h0m0s

# Longest lifetime of a session, whatever its use.
# Key auth.session.lifetime, flag --auth-session-lifetime. Used by Serve, Seed.
# CONFAB_AUTH_SESSION_LIFETIME=2160h0m0s

# Lifetime of an access token.
# Key auth.access.lifetime, flag --auth-access-lifetime. Used by Serve, Seed.
# CONFAB_AUTH_ACCESS_LIFETIME=10m0s

# How long a replaced refresh token still returns its successor.
# Key auth.refresh.grace, flag --auth-refresh-grace. Used by Serve, Seed.
# CONFAB_AUTH_REFRESH_GRACE=10s

# Lifetime of a sign-in flow.
# Key auth.flow.lifetime, flag --auth-flow-lifetime. Used by Serve, Seed.
# CONFAB_AUTH_FLOW_LIFETIME=15m0s

# How recent a proof must be to change a factor.
# Key auth.fresh.window, flag --auth-fresh-window. Used by Serve, Seed.
# CONFAB_AUTH_FRESH_WINDOW=10m0s

# Digits in a code.
# Key auth.code.length, flag --auth-code-length. Used by Serve, Seed.
# CONFAB_AUTH_CODE_LENGTH=6

# Lifetime of a code.
# Key auth.code.lifetime, flag --auth-code-lifetime. Used by Serve, Seed.
# CONFAB_AUTH_CODE_LIFETIME=5m0s

# Wrong tries a code allows.
# Key auth.code.tries, flag --auth-code-tries. Used by Serve, Seed.
# CONFAB_AUTH_CODE_TRIES=5

# Wait before another code may be sent.
# Key auth.code.resend, flag --auth-code-resend. Used by Serve, Seed.
# CONFAB_AUTH_CODE_RESEND=1m0s

# Codes a user may be sent in an hour.
# Key auth.code.hourly, flag --auth-code-hourly. Used by Serve, Seed.
# CONFAB_AUTH_CODE_HOURLY=5

# Lifetime of a recovery link.
# Key auth.link.lifetime, flag --auth-link-lifetime. Used by Serve, Seed.
# CONFAB_AUTH_LINK_LIFETIME=30m0s

# Lifetime of an invitation.
# Key auth.invitation.lifetime, flag --auth-invitation-lifetime. Used by Serve, Seed.
# CONFAB_AUTH_INVITATION_LIFETIME=72h0m0s

# Lifetime of a registered device.
# Key auth.device.lifetime, flag --auth-device-lifetime. Used by Serve, Seed.
# CONFAB_AUTH_DEVICE_LIFETIME=2160h0m0s

# Fewest characters in a password.
# Key auth.password.min_length, flag --auth-password-min-length. Used by Serve, Seed.
# CONFAB_AUTH_PASSWORD_MIN_LENGTH=12

# Least strength a new password needs, 3 or 4.
# Key auth.password.min_score, flag --auth-password-min-score. Used by Serve, Seed.
# CONFAB_AUTH_PASSWORD_MIN_SCORE=4

# Memory for each password hash, in MiB.
# Key auth.password.memory, flag --auth-password-memory. Used by Serve, Seed.
# CONFAB_AUTH_PASSWORD_MEMORY=64

# Passes of each password hash.
# Key auth.password.time, flag --auth-password-time. Used by Serve, Seed.
# CONFAB_AUTH_PASSWORD_TIME=2

# Password hashes at once.
# Default: from runtime.NumCPU.
# Key auth.password.concurrency, flag --auth-password-concurrency. Used by Serve, Seed.
# CONFAB_AUTH_PASSWORD_CONCURRENCY=

# Failures before waits start.
# Key auth.throttle.free, flag --auth-throttle-free. Used by Serve, Seed.
# CONFAB_AUTH_THROTTLE_FREE=5

# Longest wait.
# Key auth.throttle.ceiling, flag --auth-throttle-ceiling. Used by Serve, Seed.
# CONFAB_AUTH_THROTTLE_CEILING=15m0s

# Time without a failure after which a counter starts again.
# Key auth.throttle.window, flag --auth-throttle-window. Used by Serve, Seed.
# CONFAB_AUTH_THROTTLE_WINDOW=1h0m0s

# Drop Secure and the __Host- prefix, for development over plain HTTP.
# Key auth.cookie.insecure, flag --auth-cookie-insecure. Used by Serve, Seed.
# CONFAB_AUTH_COOKIE_INSECURE=

# Domain passkeys are bound to: the site's, without scheme or port.
# Required.
# Key auth.passkey.domain, flag --auth-passkey-domain. Used by Serve, Seed.
# CONFAB_AUTH_PASSKEY_DOMAIN=

# Origins passkeys may be used from; https://<domain> when empty.
# Key auth.passkey.origins, flag --auth-passkey-origins. Used by Serve, Seed.
# CONFAB_AUTH_PASSKEY_ORIGINS=

# Brand colour.
# Key theme.brand_color, flag --theme-brand-color. Used by Serve.
# CONFAB_THEME_BRAND_COLOR="#2f5bd3"

# Danger colour.
# Key theme.danger_color, flag --theme-danger-color. Used by Serve.
# CONFAB_THEME_DANGER_COLOR="#c62828"

# Warning colour.
# Key theme.warning_color, flag --theme-warning-color. Used by Serve.
# CONFAB_THEME_WARNING_COLOR="#f2b01e"

# Success colour.
# Key theme.success_color, flag --theme-success-color. Used by Serve.
# CONFAB_THEME_SUCCESS_COLOR="#1e8a4c"

# Information colour.
# Key theme.info_color, flag --theme-info-color. Used by Serve.
# CONFAB_THEME_INFO_COLOR="#0f7c9e"

# Text font.
# Key theme.font_sans, flag --theme-font-sans. Used by Serve.
# CONFAB_THEME_FONT_SANS="system-ui, \"Segoe UI\", \"Roboto\", \"Noto Sans\", \"Noto Sans Arabic\", sans-serif"

# Code font.
# Key theme.font_mono, flag --theme-font-mono. Used by Serve.
# CONFAB_THEME_FONT_MONO="ui-monospace, \"SFMono-Regular\", \"Menlo\", \"Consolas\", monospace"

# Corner radius.
# Key theme.radius, flag --theme-radius. Used by Serve.
# CONFAB_THEME_RADIUS=0.5rem

# Locale for visitors without a chosen locale; empty means the source locale.
# Key i18n.default_locale, flag --i18n-default-locale. Used by Serve.
# CONFAB_I18N_DEFAULT_LOCALE=

# Refuse new talks.
# Key cfp.closed, flag --cfp-closed. Used by Serve.
# CONFAB_CFP_CLOSED=

# Talks a speaker may give at one event.
# Key cfp.max_talks, flag --cfp-max-talks. Used by Serve.
# CONFAB_CFP_MAX_TALKS=3

# Level a new talk starts at; one of beginner, intermediate, advanced.
# Key cfp.default_level, flag --cfp-default-level. Used by Serve.
# CONFAB_CFP_DEFAULT_LEVEL=beginner

# Length a new talk starts at.
# Key cfp.default_duration, flag --cfp-default-duration. Used by Serve.
# CONFAB_CFP_DEFAULT_DURATION=30m0s

# Organiser's email address.
# Key demo.email, flag --demo-email. Used by Seed.
# CONFAB_DEMO_EMAIL=ada@confab.example

# Organiser's name.
# Key demo.name, flag --demo-name. Used by Seed.
# CONFAB_DEMO_NAME="Ada Organiser"

# Organiser's password.
# Required. Secret: set it in the environment, not here.
# Key demo.password. Used by Seed.
# CONFAB_DEMO_PASSWORD=
